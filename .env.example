APP_NAME=Gofio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gofio
DB_USERNAME=root
DB_PASSWORD=

# Producción (Fase 3): CACHE_STORE=redis, QUEUE_CONNECTION=redis, BROADCAST_CONNECTION=reverb

# Producción (alta concurrencia): usar Redis para cache, sesiones, colas y Reverb escalado.
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Cliente Redis por defecto (pure PHP, sin extensión). Alternativa más rápida: phpredis (requiere ext-redis).
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOFIO_PLATFORM_FEE=10
GOFIO_PLATFORM_USERNAME=_gofio_platform
GOFIO_CREATOR_PLUS_PRICE=50
GOFIO_CREATOR_PLUS_DAYS=30

# Font Awesome Pro+ (opcional — packs Graphite y Slab en icon-packs/gemas/)
# Token npm: fontawesome.com → Account → Package Token
FONTAWESOME_PACKAGE_TOKEN=
# ID del Kit (ej. abc1234) con Graphite/Slab habilitados
FONTAWESOME_KIT_ID=
# Rutas manuales a SVG (alternativa al Kit npm)
# FA_GRAPHITE_SOURCE=
# FA_SLAB_REGULAR_SOURCE=
# FA_SLAB_PRESS_SOURCE=
# FA_SLAB_DUO_SOURCE=
# FA_SLAB_PRESS_DUO_SOURCE=

# GIPHY — buscador de GIFs en posts, comentarios y biografía (developers.giphy.com)
GIPHY_API_KEY=
