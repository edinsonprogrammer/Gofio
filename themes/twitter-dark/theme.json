{
    "name": "Twitter Dark",
    "slug": "twitter-dark",
    "description": "Layout de navegación lateral tipo Twitter/X con paleta oscura. El menú de navegación ocupa la columna izquierda fija.",
    "author": "Gofio",
    "version": "1.0.0",
    "is_default": false,
    "requires_creator_plus": false,
    "layout_variant": "sidebar-nav",
    "variables": {
        "--bg-principal":               "#15202B",
        "--text-principal":             "#F7F9F9",
        "--color-brand":                "#1D9BF0",
        "--color-surface":              "#1E2732",
        "--color-border":               "#2F3336",
        "--color-muted":                "#8B98A5",
        "--color-link":                 "#1D9BF0",
        "--color-topbar-dark":          "#15202B",
        "--color-panel":                "#22303C",
        "--color-brand-hover":          "#1A8CD8",
        "--color-input-border":         "#2F3336",
        "--color-btn-secondary-bg":     "#22303C",
        "--color-btn-secondary-border": "#2F3336",
        "--color-btn-secondary-text":   "#F7F9F9",
        "--color-topbar-gradient-from": "#15202B",
        "--color-topbar-gradient-to":   "#1E2732",
        "--color-accent":               "#1D9BF0",
        "--color-accent-soft":          "#1A3A4A",

        "--color-success":              "#00BA7C",
        "--color-success-soft":         "#0D2E24",
        "--color-error":                "#F4212E",
        "--color-error-soft":           "#2E0D11",

        "--font-sans":                  "'-apple-system', 'BlinkMacSystemFont', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
        "--font-size-base":             "15px",

        "--radius-sm":                  "4px",
        "--radius-md":                  "9999px",
        "--radius-lg":                  "16px",
        "--radius-xl":                  "24px",

        "--shadow-card":                "0 1px 4px rgba(0,0,0,0.4)",
        "--shadow-elevated":            "0 4px 20px rgba(0,0,0,0.5)",
        "--shadow-topbar":              "none",

        "--sidenav-width":              "240px"
    }
}
